SELECT Catalog_Item__r.Breadcrumb__c
    , Catalog_Item__r.Catalog_Display_Name_2__c
    , Catalog_Item__r.Package_Catalog__c
    , Catalog_Item__r.Media_Types__c
    , Bundle__r.Bundle_Name__c
    , Bundle__r.Id
    , Bundle__r.Iniciativa_de_Cadastro__c
    , Bundle__r.Vertical__c
FROM PriceItem__c
WHERE Bundle__r.Status__c ='Approved' 
AND Bundle__r.CreatedDate >= 2025-01-01T00:00:00.000-03:00 
AND Catalog_Item__r.Media_Types__c = 'PayTV' 
AND Bundle__r.Id = 'a34bL000001yP9RQAU' 
LIMIT 1