SELECT id
    , ParentId
    , Parent.Bundle_Name__c
    , parent.Origem_Produto__r.Name
    , Field
    , OldValue
    , NewValue
    , CreatedBy.Name
    , CreatedDate
    , Parent.CreatedDate
    , Parent.Vertical__c
    , Parent.Vertical_Secundaria__c
    , Parent.Net_Price__c
    , parent.Valor_TV__c
    , parent.Valor_Tabela_TV_PayTV__c
    , Parent.Valor_Digital__c
FROM Bundle__History
WHERE Parent.Status__c ='Approved'
    AND parent.CreatedDate >= 2025-04-01T00:00:00.000-03:00