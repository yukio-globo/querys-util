SELECT Id
    , cat_CanalVertical__r.Name
    , cat_ProgramaFaixaHoraria__r.Name
    , cat_Produto__r.Name
    , cat_Produto__r.cat_CodigoSiscom__c
    , cat_Produto__r.cat_Codigo_Operative1__c
    , cat_Plataforma__c
    , cat_Praca__r.cat_Sigla__c
    , cat_UnidadeMedida__c
    , cat_Duracao__c
    , cat_PrecoUnitario__c
    , cat_ExibicaoDe__c
    , cat_ExibicaoAte__c
    , cat_DataVendaInicio__c
    , cat_DataVendaFim__c
    , cat_Status__c
    , CreatedBy.Name
    , CreatedDate
FROM Price_Book_Entry_Detail__c
WHERE id = 'a0Fbe000003DOMCEA4'

Select id
    , Name
    , cat_CanalVertical__r.Name
    , cat_ProgramaFaixaHoraria__r.Name
    , cat_DataVendaInicio__c
    , cat_DataVendaFim__c
    , cat_ExibicaoDe__c
    , cat_ExibicaoAte__c
    , cat_PrecoUnitario__c
    , cat_FormatoPreco__c
    , cat_PriceBook__r.Name
    , cat_pricebook__r.id
    , cat_PriceBook__r.cat_TipoLista__c
from Price_Book_Entry_Detail__c
where cat_Status__c ='Ativo'
    AND cat_FormatoPreco__c ='Faixa Horária'
order by cat_PriceBook__r.id, cat_CanalVertical__r.Name 