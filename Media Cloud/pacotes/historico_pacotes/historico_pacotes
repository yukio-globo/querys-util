SELECT Id
    , Product2Id
    , Product2.Name
    , Field
    , OldValue
    , NewValue
    , CreatedBy.Name
    , CreatedDate
    , Product2.CreatedDate
    , Product2.cat_VerticalPrincipal__c
    , Product2.cat_VerticalSecundaria__c
FROM Product2History
WHERE Product2.cat_Status__c = 'Aprovado' 
    AND Field = 'cat_Status__c'
    AND Product2.CreatedDate >= 2026-01-01T00:00:00.000-03:00
    /*Product2Id = '01tbe00000A1SEg'*/