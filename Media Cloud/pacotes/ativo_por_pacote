SELECT Quote.cat_Pacote__r.Id
    , Quote.cat_Pacote__r.Name
    , quote.cat_Pacote__r.cat_ProdutoOrigem__r.Name
    , quote.cat_Pacote__r.cat_VerticalPrincipal__c
    , quote.cat_Pacote__r.cat_VerticalSecundaria__c
    , quote.cat_Pacote__r.cat_Cota__r.Name
    , quote.cat_Pacote__r.cat_Cota__r.cat_QtdeCotas__c
    , Product2.Name
    , Product2.cat_Sigla__c
    , Product2.cat_CodigoSiscom__c
    , Product2.cat_Codigo_Operative1__c
FROM QuoteLineItem
WHERE Quote.cat_Pacote__r.CreatedDate >= 2026-03-01T00:00:00.000-03:00 
AND quote.cat_Pacote__r.cat_Status__c = 'Aprovado' 