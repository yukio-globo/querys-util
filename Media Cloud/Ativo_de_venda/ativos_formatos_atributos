/*Query para extrair Ativos de Venda com Formatos e Atributos*/
SELECT FIELDS(ALL),
   (
      SELECT Id, Name 
      FROM ProductAttributeDefinitions
   ),
   (
      SELECT AdSpaceSpecificationId
      FROM AdSpaceSpecProducts
   )
FROM Product2
LIMIT 200

/*Querys para extrair os valores dos Atributos dos Ativos:
Mapeia todos os valores possíveis de picklist por PicklistId*/
 
SELECT Id
   , Name
   , PicklistId
   , Status
FROM AttributePicklistValue
WHERE PicklistId IN (SELECT PicklistId FROM AttributeDefinition) 
   AND Status = 'Active'
 
