SELECT Id
    , Name , cat_Sigla__c
    , cat_Codigo_Operative1__c
    , cat_CodigoSiscom__c
    , cat_AtivoBase__c
    , cat_Status__c
FROM Product2
WHERE cat_Status__c ='Aprovado' 
    AND type != 'Bundle'
    AND RecordType.Name = 'Configuração'
    AND cat_Status__c IN ('Aprovado','Em Precificação')



    select count(id), RecordType.Name, Family from Product group by RecordType Name, Family


SELECT Id
    , DefaultValue
    , Product2.cat_CodigoSiscom__c
FROM ProductAttributeDefinition
WHERE AttributeDefinition.Name = 'Possui Vazamento para Simulcast (AA)?' AND DefaultValue = 'True'
    AND Product2.Recordtype.name = 'Configuração'
ORDER BY Product2.cat_CodigoSiscom__c DESC
